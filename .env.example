# Genereer een willekeurige sleutel van minimaal 32 tekens.
SECRET_KEY=vervang-door-een-lange-willekeurige-geheime-sleutel
# Genereer met het commando in de installatiehandleiding. Gebruik Portainer environment variables.
PASSWORD_HASH=vervang-dit
BIND_ADDRESS=0.0.0.0
COOKIE_SECURE=false
IMAGE_TAG=latest
APP_MEMORY=512m
PIPER_MEMORY=2g
BRIDGE_MEMORY=256m
SUPERTONIC_MEMORY=4g
